# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Server-only (never reach the browser bundle) ---------------------------

# Signs the order cookie (HMAC-SHA256). At least 32 random characters.
# Required in production; `next dev` falls back to a fixed dev-only key.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_COOKIE_SECRET=

# The restaurant's WhatsApp number for the order page's "WhatsApp us" link,
# with the country code and no "+": 2348031234567
RESTAURANT_WHATSAPP=2348000000000

# --- Public (copied into the JavaScript bundle at build time) ---------------

# Shown on error screens, which are Client Components and can only read
# NEXT_PUBLIC_ variables.
NEXT_PUBLIC_RESTAURANT_PHONE=+234 800 000 0000

# --- Testing helpers (leave empty in production) ----------------------------

# Pretend it's this time in Lagos when the server starts (HH:MM), then keep
# ticking. Handy for testing open/closed and pickup slots at night.
BUKA_CLOCK=

# Speed up the order timeline: 0.1 makes a 20-minute kitchen take 2 minutes,
# so you can watch the status tracker move. Between 0.01 and 1.
BUKA_TIME_SCALE=
